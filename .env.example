# .env.example — документация всех env-переменных bee_swarm
# Скопируй в .env и раскомментируй нужные. Файл .env НЕ обязателен —
# без него всё работает через дефолты (getenv ?: default в коде).
# Приоритет: реальное окружение > .env > кодовые дефолты.

# === Пути ===
# SWARM_DB_PATH=:memory:
# FORAGER_SOURCES=/path/to/csv/dir:/path/to/other
# CORPUS_DIRS=/path/to/corpus
# METRICS_PATH=/path/to/metrics.jsonl

# === Энергетика (§2.1, (E)-параметры — взаимные отношения = экономика) ===
# SEED_ENERGY=10.0
# SEED_REWARD=2.0

# === Поиск ===
# SEARCH_DEPTH=2
# SEARCH_DEPTH_MAX=4
# SEARCH_BEAM_K=10
# SEARCH_BEAM_RANDOM=5
# NULL_SIGNAL_RATIO=0.55
# SEARCH_DEBUG=1
# SEARCH_PROFILE=1
# SEARCH_NO_PREREG=1

# === Грамматика ===
# BINARY_B_CAP=3
# MAX_ARITY=3
# NO_BIRTH=1
# CULTURE_LEVEL=1.0
# PROPAGATION=0

# === Forager ===
# FORAGER_MAX_ROWS=50
# FORAGER_MAX_COLS=24
# FORAGER_COMBO_CAP=200
# NO_BASE_TASKS=1

# === Диссипация ===
# DORMANT_POOL_MAX=50000
# SPAWN_POOL_EVERY=100
# SPAWN_POOL_K=2
# CANDIDATE_TTL_HOURS=24

# === Диагностика ===
# PROFILE=1
# MONOCULTURE_ALARM_DIVERSITY=0.3
